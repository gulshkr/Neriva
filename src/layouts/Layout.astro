---
import Analytics from '@vercel/analytics/astro';
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title || "Physiotherapy Clinic in Faridabad | Neriva Health"}</title>
    <meta name="description" content={description || "Professional physiotherapy & rehabilitation in Faridabad."}>
    
    <meta property="og:title" content={title || "Physiotherapy Clinic in Faridabad | Neriva Health"}>
    <meta property="og:description" content={description || "Professional physiotherapy & rehabilitation in Faridabad."}>
    <meta property="og:image" content="/images/logo.jpg">
    <meta property="og:type" content="website">

    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="stylesheet" href="/style.css">
    
    <Analytics />
    
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MedicalClinic",
      "name": "Nerivahealth Physiotherapy & Rehabilitation Centre",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "House No. 114, 1st Floor, Sector-45",
        "addressLocality": "Faridabad",
        "addressRegion": "Haryana",
        "postalCode": "121010",
        "addressCountry": "IN"
      },
      "telephone": "+91-9650940281",
      "url": "https://nerivahealth.com",
      "sameAs": [
        "https://www.instagram.com/nerivahealth_physio_rehab/"
      ],
      "openingHours": "Mo-Su 10:00-20:00",
      "image": "https://nerivahealth.com/images/logo.jpg"
    }
    </script>
</head>
<body>

    <header class="site-header">
        <div class="container header-container">
            <a href="/" class="logo">
                <img src="/images/logo.jpg" alt="Nerivahealth Physiotherapy Logo">
            </a>
            
            <nav class="main-nav" id="main-nav">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/#conditions">Conditions</a></li>
                    <li class="dropdown">
                        <a href="#services" class="dropbtn">Services <span style="font-size: 0.7em;">▼</span></a>
                        <div class="dropdown-content">
                            <a href="/rehabilitation/sports-injury">Sports Injury</a>
                            <a href="/rehabilitation/post-surgery">Post-Surgery</a>
                            <a href="/rehabilitation/stroke-rehabilitation">Stroke Rehab</a>
                            <a href="/home-physiotherapy-faridabad">Home Physio</a>
                        </div>
                    </li>
                    <li><a href="/about/dr-abhishek-kumar">About Dr. Abhishek</a></li>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/#contact">Contact</a></li>
                    <li class="mobile-nav-social">
                        <a href="https://www.instagram.com/nerivahealth_physio_rehab/" target="_blank" rel="noopener noreferrer">
                            <span style="display: inline-flex; align-items: center; gap: 0.5rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                                </svg>
                                Instagram: @nerivahealth_physio_rehab
                            </span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="header-cta">
                <a href="https://www.instagram.com/nerivahealth_physio_rehab/" target="_blank" rel="noopener noreferrer" class="header-social-link" aria-label="Nerivahealth Instagram" title="Follow us on Instagram (@nerivahealth_physio_rehab)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                    </svg>
                </a>
                <a href="tel:9650940281" class="btn btn-primary">Call: 9650940281</a>
                <div class="mobile-nav-toggle" id="mobile-toggle" aria-label="Toggle menu">
                    ☰
                </div>
            </div>
        </div>
    </header>

    <main>
        <slot />
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-col">
                <img src="/images/logo.jpg" alt="Nerivahealth" style="height: 40px; margin-bottom: 1rem; filter: brightness(0) invert(1);">
                <p style="color: #CBD5E1; max-width: 300px;">Evidence-based, personalized physiotherapy and comprehensive rehabilitation across Faridabad.</p>
                <p style="color: #CBD5E1; margin-top: 0.75rem;"><a href="mailto:nerivahealth@nerivahealth.com">nerivahealth@nerivahealth.com</a></p>
                <div style="margin-top: 1.25rem;">
                    <a href="https://www.instagram.com/nerivahealth_physio_rehab/" target="_blank" rel="noopener noreferrer" class="footer-social-pill" aria-label="Nerivahealth on Instagram">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                        </svg>
                        <span>@nerivahealth_physio_rehab</span>
                    </a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Quick Links</h4>
                <a href="/#home">Home</a>
                <a href="/#services">Services</a>
                <a href="/blog">Blog & Stories</a>
                <a href="/#contact">Contact</a>
            </div>
            <div class="footer-col">
                <h4>Connect With Us</h4>
                <a href="https://www.instagram.com/nerivahealth_physio_rehab/" target="_blank" rel="noopener noreferrer" class="footer-link-with-icon" aria-label="Follow us on Instagram">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                    </svg>
                    <span>Instagram Profile</span>
                </a>
                <a href="https://wa.me/919650940281?text=Hello,%20I%20would%20like%20to%20book%20a%20consultation%20at%20Nerivahealth%20Physiotherapy." target="_blank" rel="noopener noreferrer" class="footer-link-with-icon">
                    <span>💬 WhatsApp Support</span>
                </a>
                <a href="tel:9650940281" class="footer-link-with-icon">
                    <span>📞 9650940281</span>
                </a>
            </div>
            <div class="footer-col">
                <h4>Legal</h4>
                <p style="color: #CBD5E1; font-size: 0.9rem;">The information on this website is for educational purposes and does not replace professional medical advice.</p>
                <br>
                <p style="color: #CBD5E1; font-size: 0.9rem;">&copy; 2026 Nerivahealth Physiotherapy & Rehabilitation Centre.</p>
            </div>
        </div>
    </footer>

    <div class="mobile-sticky-footer">
        <a href="tel:9650940281" class="btn btn-primary">📞 Call Now</a>
        <a href="https://wa.me/919650940281?text=Hello,%20I%20would%20like%20to%20book%20a%20consultation%20at%20Nerivahealth%20Physiotherapy." target="_blank" class="btn btn-accent">💬 WhatsApp</a>
    </div>

    <!-- Floating WhatsApp Button -->
    <a href="https://wa.me/919650940281?text=Hello,%20I%20would%20like%20to%20book%20a%20consultation%20at%20Nerivahealth%20Physiotherapy." target="_blank" class="whatsapp-float">
        💬
    </a>

    <script src="/script.js" is:inline></script>
</body>
</html>
