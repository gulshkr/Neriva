---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---

<Layout 
    title={`${frontmatter.title} | Nerivahealth`} 
    description={frontmatter.description}
>
    <style>
        .article-header {
            background-color: var(--primary-blue);
            color: var(--white);
            padding: 4rem 0;
            text-align: center;
        }
        .article-header h1 {
            color: var(--white);
            font-size: 2.5rem;
            margin-bottom: 1rem;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }
        .article-meta {
            color: #CBD5E1;
            font-size: 0.9rem;
        }
        .article-content {
            max-width: 800px;
            margin: 0 auto;
            background: var(--white);
            padding: 3rem;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            margin-top: -3rem;
            position: relative;
        }
        /* Markdown generated styles */
        .article-content :global(h2) {
            margin-top: 2rem;
            margin-bottom: 1rem;
            color: var(--primary-blue);
        }
        .article-content :global(p) {
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
            color: var(--text-light);
        }
        .article-content :global(ul) {
            margin-bottom: 1.5rem;
            padding-left: 2rem;
            list-style: disc;
            color: var(--text-light);
            font-size: 1.1rem;
        }
        .article-content :global(li) {
            margin-bottom: 0.5rem;
        }
        .author-box {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid #E2E8F0;
        }
        .author-img {
            width: 60px;
            height: 60px;
            background: var(--secondary-teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-weight: bold;
            font-size: 1.5rem;
        }
    </style>

    <section class="article-header">
        <div class="container">
            <h1>{frontmatter.title}</h1>
            <p class="article-meta">Published on {frontmatter.date} | Category: {frontmatter.category}</p>
        </div>
    </section>

    <section class="section-padding" style="background: var(--bg-light)">
        <div class="container">
            <div class="article-content">
                
                <slot />

                <div style="text-align: center; margin-top: 2rem;">
                    <a href="/#contact" class="btn btn-primary">Book an Assessment Today</a>
                </div>

                <div class="author-box">
                    <div class="author-img">AK</div>
                    <div>
                        <h4 style="margin-bottom: 0.25rem;">Written by Dr. Abhishek Kumar (PT)</h4>
                        <p style="margin: 0; font-size: 0.9rem;">BPT, MPT (Orthopedics)</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
