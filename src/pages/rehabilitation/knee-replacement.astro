---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
    title="Knee Replacement Rehabilitation in Faridabad | Neriva Health" 
    description="Post-operative physiotherapy for Total Knee Replacement (TKR) in Faridabad. Home visits and clinic sessions available."
>
    <section class="section-padding" style="margin-top: 4rem;">
        <div class="container">
            <h1 style="margin-bottom: 1.5rem; color: var(--primary-blue);">Knee Replacement Rehabilitation</h1>
            <p style="font-size: 1.125rem; color: var(--text-light); max-width: 800px; line-height: 1.8; margin-bottom: 3rem;">
                Recovering from a Total Knee Replacement (TKR) requires immediate and consistent physiotherapy to restore bending, straightening, and walking ability. We provide step-by-step guidance both in-clinic and at home.
            </p>
        </div>
    </section>
</Layout>
