            <a href="https://wa.me/919650940281?text=Hi,%20I%20have%20a%20sports%20injury%20and%20need%20rehabilitation." target="_blank" class="btn btn-accent" style="margin-right: 1rem;">Chat on WhatsApp</a>
            <a href="tel:9650940281" class="btn btn-primary">Call Clinic</a>
        </div>
    </section>
</Layout>
