---
import Layout from '../layouts/Layout.astro';

// Placeholder testimonials (8 patient recovery stories across conditions) — replace with approved patient reviews when ready
const testimonials = [
    {
        name: "Rakesh Verma",
        condition: "Chronic Lower Back Pain & Sciatica",
        tag: "Spine Rehabilitation",
        location: "Sector 14, Faridabad",
        rating: 5,
        quote: "I struggled with severe lower back pain and sciatica stiffness for over 6 months from long desk hours. After a thorough assessment and 4 weeks of targeted physiotherapy and core exercises with Dr. Abhishek, I am now completely pain-free and back to my normal routine.",
        initials: "RV"
    },
    {
        name: "Sunita Mehra",
        condition: "Post Knee Replacement Rehab",
        tag: "Post-Surgical Recovery",
        location: "Sector 45, Faridabad",
        rating: 5,
        quote: "Dr. Abhishek provided post-operative home physiotherapy after my mother's knee replacement surgery. His patience, gentle guidance, and structured exercise plans helped her regain full knee flexion and walking confidence without any support.",
        initials: "SM"
    },
    {
        name: "Kunal Sharma",
        condition: "Rotator Cuff & Shoulder Strain",
        tag: "Sports Injury",
        location: "Greenfield Colony, Faridabad",
        rating: 5,
        quote: "Suffered a shoulder strain during workout sessions. Dr. Abhishek's thorough biomechanical assessment, manual therapy, and recovery plan restored my full range of motion much faster than expected. Very professional clinic!",
        initials: "KS"
    },
    {
        name: "Anjali Gupta",
        condition: "Cervical Spondylosis & Neck Stiffness",
        tag: "Cervical Care",
        location: "Sector 21C, Faridabad",
        rating: 5,
        quote: "Long laptop hours caused acute neck spasms and tension headaches. The ergonomic guidance, manual release, and postural strengthening exercises designed by Dr. Abhishek relieved my chronic neck pain completely within a month.",
        initials: "AG"
    },
    {
        name: "Vikram Singh",
        condition: "Post-Stroke Mobility & Motor Rehab",
        tag: "Neurological Rehab",
        location: "Sector 31, Faridabad",
        rating: 5,
        quote: "After my father had a mild stroke, we engaged Nerivahealth for neurological rehabilitation. Dr. Abhishek's consistent, dedicated sessions dramatically improved his balance, limb strength, and ability to walk independently.",
        initials: "VS"
    },
    {
        name: "Priya Malhotra",
        condition: "Adhesive Capsulitis (Frozen Shoulder)",
        tag: "Joint Mobility",
        location: "Sector 16, Faridabad",
        rating: 5,
        quote: "My shoulder had become so stiff that I couldn't even raise my arm to comb my hair. With regular gentle joint mobilization, heat therapy, and home exercises guided by Dr. Abhishek, I regained 95% of my shoulder movement in 6 weeks.",
        initials: "PM"
    },
    {
        name: "Harish Chawla",
        condition: "Severe Knee Osteoarthritis",
        tag: "Geriatric Care",
        location: "Sector 46, Faridabad",
        rating: 5,
        quote: "At 68, walking was becoming painful due to knee osteoarthritis. Instead of rushing to surgery, Dr. Abhishek created a targeted strengthening program for my legs and hips. My pain levels dropped significantly and daily morning walks are enjoyable again.",
        initials: "HC"
    },
    {
        name: "Meenakshi Rawat",
        condition: "Post-Fracture Ankle Rehabilitation",
        tag: "Orthopedic Care",
        location: "NIT 3, Faridabad",
        rating: 5,
        quote: "After cast removal, my ankle was stiff, swollen, and weak. The progressive rehabilitation, balance training, and gait correction at Nerivahealth got me back to wearing normal shoes and climbing stairs pain-free.",
        initials: "MR"
    }
];
---

<Layout 
    title="Nerivahealth Physiotherapy Clinic in Sector 45, Faridabad" 
    description="Professional physiotherapy & rehabilitation in Sector 45, Faridabad. Dr. Abhishek Kumar (PT) treats back pain, neuro conditions, and sports injuries. Book now."
>
    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="container">
            <h1>Physiotherapy & Rehabilitation Clinic in Faridabad</h1>
            <p class="subtext">Personalized physiotherapy for back pain, neck pain, knee problems, sports injuries, post-surgery recovery and neurological rehabilitation — at our Sector 45 clinic or through home visits across Faridabad.</p>
            <div class="hero-ctas">
                <a href="#contact" class="btn btn-primary">Book a Consultation</a>
                <a href="https://wa.me/919650940281?text=Hello,%20I%20would%20like%20to%20book%20a%20consultation%20at%20Nerivahealth%20Physiotherapy." target="_blank" class="btn btn-accent">Chat on WhatsApp</a>
            </div>
        </div>
    </section>

    <!-- Trust Bar -->
    <div class="trust-bar">
        <div class="container">
            Led by Dr. Abhishek Kumar (PT) | BPT, MPT (Orthopedics) | HSCP Reg. No. - HSCP/PT/2022/1583
        </div>
    </div>

    <!-- Conditions Grid -->
    <section id="conditions" class="section-padding">
        <div class="container">
            <h2 class="section-title">Conditions We Treat</h2>
            <div class="grid-3">
                <a href="/conditions/back-pain" class="card" style="text-decoration: none; color: inherit;">
                    <div class="card-icon">🦴</div>
                    <h3>Orthopedic Conditions</h3>
                    <p>Relief for back pain, neck pain, frozen shoulder, and arthritis with targeted manual therapy and exercises.</p>
                </a>
                <a href="/rehabilitation/stroke-rehabilitation" class="card" style="text-decoration: none; color: inherit;">
                    <div class="card-icon">🧠</div>
                    <h3>Neurological Rehab</h3>
                    <p>Dedicated support for stroke recovery, paralysis, and nerve-related conditions like sciatica.</p>
                </a>
                <a href="/rehabilitation/post-surgery" class="card" style="text-decoration: none; color: inherit;">
                    <div class="card-icon">🦿</div>
                    <h3>Post-Operative Care</h3>
                    <p>Safe, guided rehabilitation following joint replacements and orthopedic surgeries to restore full function.</p>
                </a>
                <a href="/rehabilitation/sports-injury" class="card" style="text-decoration: none; color: inherit;">
                    <div class="card-icon">🏃</div>
                    <h3>Sports Rehabilitation</h3>
                    <p>Advanced manual therapy, cupping, and taping for sports injury recovery and joint pain.</p>
                </a>
                <a href="/conditions/knee-pain" class="card" style="text-decoration: none; color: inherit;">
                    <div class="card-icon">🧠</div>
                    <h3>Pain Management</h3>
                    <p>Comprehensive care plans for chronic pain, arthritis, and nerve compressions.</p>
                </a>
            </div>
        </div>
    </section>

    <!-- Treatment Approach -->
    <section id="approach" class="section-padding" style="background: var(--bg-light)">
        <div class="container">
            <h2 class="section-title">Your Journey to Recovery</h2>
            <div class="approach-steps">
                <div class="step">
                    <div class="step-number">1</div>
                    <div>
                        <h3>Detailed Assessment</h3>
                        <p>We focus on understanding the factors contributing to your symptoms and create a rehabilitation plan based on your assessment and goals.</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number">2</div>
                    <div>
                        <h3>Personalized Treatment Plan</h3>
                        <p>Dr. Abhishek designs an individualized rehabilitation plan tailored to your lifestyle, pain levels, and recovery goals.</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number">3</div>
                    <div>
                        <h3>Active Rehabilitation</h3>
                        <p>Hands-on therapy, guided exercises, and advanced techniques (cupping/taping) are used to restore mobility and reduce pain.</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number">4</div>
                    <div>
                        <h3>Progress & Prevention</h3>
                        <p>We monitor your progress and provide education to prevent future injuries.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Doctor -->
    <section id="about" class="section-padding">
        <div class="container">
            <h2 class="section-title">Meet Dr. Abhishek Kumar (PT)</h2>
            <div style="max-width: 800px; margin: 0 auto; text-align: center;">
                <p style="font-size: 1.125rem; color: var(--text-light); margin-bottom: 2rem;">
                    Dr. Abhishek Kumar is a highly qualified physiotherapist with a Master’s degree in Orthopedics. Dedicated to evidence-based practice, he specializes in treating complex musculoskeletal and neurological conditions. His patient-first approach ensures that you receive the time, attention, and specialized care necessary for a complete recovery.
                </p>
                <div style="display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem;">
                    <div><strong>Qualifications:</strong> BPT, MPT (Orthopedics)</div>
                    <div><strong>Registration:</strong> HSCP/PT/2022/1583</div>
                </div>
                <a href="/about/dr-abhishek-kumar" class="btn btn-outline" style="border: 2px solid var(--primary-blue); color: var(--primary-blue); padding: 0.75rem 1.5rem; text-decoration: none; border-radius: 0.375rem; font-weight: 600;">Learn More About Dr. Abhishek</a>
            </div>
        </div>
    </section>

    <!-- Patient Testimonials Section -->
    <section id="testimonials" class="section-padding testimonials-section" style="background: var(--bg-light); overflow: hidden;">
        <div class="container">
            <div class="testimonials-header">
                <div>
                    <span style="color: var(--secondary-teal); font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px;">Patient Stories</span>
                    <h2 class="section-title" style="text-align: left; margin-bottom: 0.5rem;">What Our Patients Say</h2>
                    <p style="color: var(--text-light); font-size: 1.05rem; margin-bottom: 0;">Real recovery stories from individuals who regained pain-free mobility with our personalized physiotherapy.</p>
                </div>
                <div class="testimonials-controls">
                    <button id="testimonial-prev" class="carousel-control-btn" aria-label="Previous Testimonial" title="Previous Testimonial">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <button id="testimonial-next" class="carousel-control-btn" aria-label="Next Testimonial" title="Next Testimonial">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Carousel Track with Infinite Seamless Duplication -->
        <div class="testimonials-carousel-wrapper">
            <div class="testimonials-carousel-track" id="testimonials-track" tabindex="0" role="region" aria-label="Patient Testimonials Carousel">
                {[...testimonials, ...testimonials].map((t) => (
                    <div class="testimonial-card">
                        <div>
                            <div class="testimonial-stars" aria-label={`Rating: ${t.rating} out of 5 stars`}>
                                {"★".repeat(t.rating)}
                            </div>
                            <p class="testimonial-text">"{t.quote}"</p>
                        </div>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">{t.initials}</div>
                            <div class="testimonial-info">
                                <h4>{t.name}</h4>
                                <p>{t.location}</p>
                                <span class="testimonial-badge">{t.tag}</span>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        <div class="container">
            <div class="testimonials-footer-row">
                <div class="testimonials-hint">
                    <span class="pause-icon">⏸</span>
                    <span>Hover over any card to pause scrolling &bull; Drag or use arrows to browse</span>
                </div>
                <div class="testimonials-summary">
                    <span style="color: #F59E0B; font-size: 1.25rem;">★★★★★</span>
                    <span><strong>5.0 / 5.0</strong> Patient Satisfaction across Faridabad</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact & Location Section -->
    <section id="contact" class="section-padding">
        <div class="container">
            <h2 class="section-title">Contact & Location</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 4rem;">
                
                <!-- Web3Forms Integration -->
                <div>
                    <h3 style="margin-bottom: 1rem;">Book a Consultation</h3>
                    <p style="margin-bottom: 2rem; color: var(--text-light);">Fill out the form below to request an appointment or consultation.</p>
                    
                    <form action="https://api.web3forms.com/submit" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
                        <input type="hidden" name="access_key" value="53d10f8e-6877-4c5a-be22-b98ee9524486">
                        
                        <div>
                            <label for="name" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Your Name</label>
                            <input type="text" id="name" name="name" required style="width: 100%; padding: 0.75rem; border: 1px solid #CBD5E1; border-radius: 0.375rem;">
                        </div>
                        <div>
                            <label for="phone" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Phone Number</label>
                            <input type="tel" id="phone" name="phone" required style="width: 100%; padding: 0.75rem; border: 1px solid #CBD5E1; border-radius: 0.375rem;">
                        </div>
                        <div>
                            <label for="message" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Brief description of issue (Optional)</label>
                            <textarea id="message" name="message" rows="4" style="width: 100%; padding: 0.75rem; border: 1px solid #CBD5E1; border-radius: 0.375rem;"></textarea>
                        </div>
                        
                        <input type="hidden" name="redirect" value="https://web3forms.com/success">

                        <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Request Appointment</button>
                    </form>
                </div>

                <!-- Location Details -->
                <div>
                    <h3 style="margin-bottom: 1rem;">Clinic Details</h3>
                    <div style="margin-bottom: 2rem; line-height: 1.8;">
                        <strong>Address:</strong><br>
                        House No. 114, 1st Floor, Sector-45,<br>
                        Faridabad, Haryana - 121010<br><br>
                        
                        <strong>Phone:</strong> <a href="tel:9650940281" style="color: var(--primary-blue); font-weight: 600;">9650940281</a><br>
                        <strong>Email:</strong> <a href="mailto:nerivahealth@nerivahealth.com" style="color: var(--primary-blue); font-weight: 600;">nerivahealth@nerivahealth.com</a><br>
                        <strong>Instagram:</strong> <a href="https://www.instagram.com/nerivahealth_physio_rehab/" target="_blank" rel="noopener noreferrer" style="color: var(--primary-blue); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;">
                                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                            </svg>
                            @nerivahealth_physio_rehab
                        </a><br>
                        <strong>Hours:</strong> 10:00 AM - 8:00 PM
                    </div>

                    <!-- Embedded Map -->
                    <div style="width: 100%; height: 250px; background: #E2E8F0; border-radius: 0.5rem; overflow: hidden;">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14032.554378950587!2d77.30944!3d28.441467!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390cddec2451bd83%3A0x7d6c4a161f3eb1a9!2sSector%2045%2C%20Faridabad%2C%20Haryana%20121003!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>

            </div>
        </div>
    </section>
</Layout>
